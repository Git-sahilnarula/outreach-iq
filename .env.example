# ==============================================================================
# Outreach IQ — Environment Configuration Template
# Copy this file to .env and configure values before starting services
# ==============================================================================

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./outreach_iq.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://outreach_user:your_password@postgres:5432/outreach_iq

# PostgreSQL Service (used by docker-compose.prod.yml)
POSTGRES_DB=outreach_iq
POSTGRES_USER=outreach_user
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here

# Security & Authentication
# CRITICAL: Replace with a 32+ character random string in production!
JWT_SECRET=outreach_iq_secure_jwt_secret_key_prod_32chars_random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# AI Provider Configuration (ollama or openai)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Optional: Cloud OpenAI Provider
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Matching Engine Threshold (0 - 100)
MATCH_THRESHOLD=75

# Phase 2 & 5 — Gmail Integration & Email Outreach
# Setup guide: docs/GMAIL_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback
GMAIL_JOB_ALERT_LABEL=Job Alerts
GMAIL_MAX_EMAILS_PER_SYNC=50

# Phase 7 — External Webhook Notifications (Optional Slack webhook for n8n)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
